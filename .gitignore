# --- native -----------------------------------------------------------------
native/build*/
build/bin/
build/dist/
build/cjktest/
native/out/
*.o
*.obj
*.so
*.dylib
*.dll
*.lib
*.a
*.exp
*.pdb
# vendored ORT runtime binaries stay out of git (the C API header is checked in)
native/third_party/onnxruntime/runtime*/
*.part

# --- go ---------------------------------------------------------------------
/chronos
/chronos.exe
/cmd/chronos/chronos
/cmd/chronos/chronos.exe
/dist/
*.test
coverage.out
coverage.html

# --- frontend ---------------------------------------------------------------
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/.vite/
frontend/wailsjs/

# --- models / runtime data --------------------------------------------------
models/*.onnx
models/*.xml
models/*.bin
libs/*.dll
libs/*.so
!libs/.gitkeep

# --- misc -------------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
# native test fixtures written into the CWD when a test binary is run manually
chronos_test_*
.tools/

# --- local/tool artifacts ---
__pycache__/
*.pyc
_install.log
